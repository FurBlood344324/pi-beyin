{
  "name": "pi-beyin",
  "version": "0.1.11",
  "description": "pi-native bridge for the beyin second brain: context injection, distillation reminders, and Jev advisor tools.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "second-brain",
    "vault",
    "context",
    "memory",
    "skills"
  ],
  "license": "MIT",
  "type": "module",
  "author": "furblood344324",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FurBlood344324/pi-beyin.git"
  },
  "pi": {
    "extensions": [
      "./extensions/context.ts",
      "./extensions/damitma.ts",
      "./extensions/jev.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "tools",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "bash test/run.sh",
    "test:live": "BEYIN_LIVE=1 bash test/run.sh",
    "test:e2e": "BEYIN_E2E=1 bash test/run.sh",
    "smoke": "bun run test/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "homepage": "https://github.com/FurBlood344324/pi-beyin#readme",
  "bugs": {
    "url": "https://github.com/FurBlood344324/pi-beyin/issues"
  }
}
