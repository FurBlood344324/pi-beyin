{
  "name": "pi-beyin",
  "version": "0.3.0",
  "description": "pi bridge for the beyin second brain (JS CLI): session-start knock (ingest, dream) and one `beyin context` injection per session and cwd, plus a serial-tool-call nudge. Skills and tools live in the vault, not here.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "second-brain",
    "vault",
    "context",
    "memory"
  ],
  "license": "MIT",
  "type": "module",
  "author": "furblood344324",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FurBlood344324/pi-beyin.git"
  },
  "pi": {
    "extensions": [
      "./extensions/beyin.ts",
      "./extensions/batch.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bash test/run.sh",
    "smoke": "bun run test/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "homepage": "https://github.com/FurBlood344324/pi-beyin#readme",
  "bugs": {
    "url": "https://github.com/FurBlood344324/pi-beyin/issues"
  }
}
