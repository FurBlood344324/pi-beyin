#!/usr/bin/env bash
# maint-scan: the reports behind the maintenance skill.
#
# It reports and never deletes or moves anything. close_steps declared in the profile are run
# (pre-approved, idempotent, derived-only), but a step that contains a delete or move is refused.
# The profile is <project>/.pi/beyin-project.json, found by walking up from the current directory.
set -uo pipefail

PROG="maint-scan"
SELF="$0"
case "$SELF" in
	/*) ;;
	*) SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")" ;;
esac

PROFILE=""
BASE=""
ROOT=""
LOGS=""
JOURNAL=""
LITERATURE=""
SOURCES=""
STATE=""
PROGRESS=""
INDEX=""
SCOPES=""
SECRETS=""
ST_TMP=""

die() { printf '%s: %s\n' "$PROG" "$1" >&2; exit 1; }

usage() {
	cat <<'EOF'
maint-scan - the mechanical scans behind the maintenance skill. It reports, it never deletes.

Usage: maint-scan <command>

Commands
  close     run the profile's close_steps from the project root, one verdict per step
            (a step that deletes or moves is refused, not run; exits 1 on a failure)
  orphans   backticked paths in state, progress and the index that do not exist
  empty     empty files in logs, journal, literature, sources and at the project root
  index     records missing from the log index, stale rows, records without a Scope
  all       the three scans in one pass, then a one-line verdict
  --self-test
  --help

Setup
  The profile is <project>/.pi/beyin-project.json, found by walking up from the current directory.
  Fields used: root, logs, journal, literature, sources, state, progress, log_index, scopes,
  secret_dirs, close_steps. Nothing under secret_dirs is read or reported.
  Without the profile every command stops with one line.

Exit codes
  close: 1 when a step failed or was refused. The scans: 0 even with findings, because a finding
  is a proposal for the user, not an error.
EOF
}

profile_path() {
	local d
	d="$(pwd -P)" || return 1
	while :; do
		if [ -f "$d/.pi/beyin-project.json" ]; then
			printf '%s' "$d/.pi/beyin-project.json"
			return 0
		fi
		[ "$d" = "/" ] && break
		d="$(dirname "$d")"
	done
	return 1
}

pget() {
	python3 - "$PROFILE" "$1" <<'PY'
import json, sys

try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    sys.exit(3)
if not isinstance(data, dict):
    sys.exit(3)
value = data.get(sys.argv[2])
if value is None:
    sys.exit(4)
if isinstance(value, list):
    for item in value:
        print(item)
elif isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
PY
}

abs() {
	case "$1" in
		/*) printf '%s' "$1" ;;
		*) printf '%s/%s' "$ROOT" "$1" ;;
	esac
}

rel() {
	case "$1" in
		"$ROOT"/*) printf '%s' "$1" | sed "s|^$ROOT/||" ;;
		*) printf '%s' "$1" ;;
	esac
}

opt_abs() {
	local v
	v="$(pget "$1")" || v=""
	[ -n "$v" ] || return 0
	abs "$v"
}

load_profile() {
	local r
	command -v python3 >/dev/null 2>&1 || die "python3 is required to read the profile"
	PROFILE="$(profile_path)" || die "no .pi/beyin-project.json found from $(pwd -P) upward"
	python3 -c 'import json,sys; json.load(open(sys.argv[1], encoding="utf-8"))' "$PROFILE" 2>/dev/null \
		|| die "cannot read $PROFILE as JSON"
	BASE="$(dirname "$(dirname "$PROFILE")")"
	r="$(pget root)" || r=""
	if [ -n "$r" ] && [ -d "$r" ]; then
		ROOT="$(cd "$r" && pwd)"
	elif [ -n "$r" ] && [ -d "$BASE/$r" ]; then
		ROOT="$(cd "$BASE/$r" && pwd)"
	else
		ROOT="$(cd "$BASE" && pwd)"
	fi
	LOGS="$(abs "$(pget logs || printf 'logs')")"
	JOURNAL="$(opt_abs journal)"
	LITERATURE="$(opt_abs literature)"
	SOURCES="$(opt_abs sources)"
	STATE="$(opt_abs state)"
	PROGRESS="$(opt_abs progress)"
	INDEX="$(opt_abs log_index)"
	SCOPES="$(pget scopes)" || SCOPES=""
	SECRETS="$(pget secret_dirs)" || SECRETS=""
	[ -n "$INDEX" ] || INDEX="$LOGS/index.md"
}

number_of() {
	local n
	n="$(printf '%s' "$1" | cut -d- -f1)"
	case "$n" in
		[0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]) ;;
		*) return 1 ;;
	esac
	printf '%s' "$n"
}

is_secret() {
	local s
	[ -n "$SECRETS" ] || return 1
	while IFS= read -r s; do
		[ -n "$s" ] || continue
		case "$1" in
			"$ROOT/$s"|"$ROOT/$s"/*) return 0 ;;
		esac
	done <<EOF
$SECRETS
EOF
	return 1
}

is_destructive() {
	if printf '%s' "$1" | grep -Eq '(^|[[:space:];&|(])(rm|rmdir|mv|dd|shred|unlink)([[:space:]]|$)'; then
		return 0
	fi
	if printf '%s' "$1" | grep -Eq 'find[[:space:]].*-delete'; then
		return 0
	fi
	return 1
}

scan_orphans() {
	local f t
	for f in "$STATE" "$PROGRESS" "$INDEX"; do
		if [ -z "$f" ] || [ ! -f "$f" ]; then continue; fi
		grep -o '`[^`]*`' "$f" 2>/dev/null | tr -d '`' | while IFS= read -r t; do
			[ -n "$t" ] || continue
			case "$t" in
				*' '*) continue ;;
				'~'*|'$'*) continue ;;
				http://*|https://*|mailto:*) continue ;;
			esac
			case "$t" in
				*/*|*.md|*.py|*.sh|*.json|*.ts|*.txt|*.csv|*.yaml|*.yml) ;;
				*) continue ;;
			esac
			case "$t" in
				./*) t="$(printf '%s' "$t" | cut -c3-)" ;;
			esac
			[ -e "$ROOT/$t" ] && continue
			printf 'orphan        %s: %s\n' "$(rel "$f")" "$t"
		done
	done
}

scan_empty() {
	local d f
	{
		for d in "$LOGS" "$JOURNAL" "$LITERATURE" "$SOURCES"; do
			if [ -z "$d" ] || [ ! -d "$d" ]; then continue; fi
			find "$d" -type f -empty -print 2>/dev/null
		done
		for f in "$ROOT"/*; do
			[ -f "$f" ] && [ ! -s "$f" ] && printf '%s\n' "$f"
		done
	} | while IFS= read -r f; do
		is_secret "$f" && continue
		printf 'empty         %s\n' "$(rel "$f")"
	done | sort -u
}

scan_index() {
	local f b n has
	if [ -z "$INDEX" ] || [ ! -f "$INDEX" ]; then
		printf 'no-index      %s\n' "$(rel "$INDEX")"
		return 0
	fi
	for f in "$LOGS"/*.md; do
		[ -e "$f" ] || continue
		b="$(basename "$f")"
		n="$(number_of "$b")" || continue
		grep -q "| $n |" "$INDEX" 2>/dev/null || printf 'not-in-index  %s\n' "$b"
		if [ -n "$SCOPES" ]; then
			awk '
				BEGIN { prefix = "- **Scope:**"; filled = 0 }
				{
					if (index($0, prefix) == 1) {
						v = substr($0, length(prefix) + 1)
						gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
						if (v != "") filled = 1
					}
				}
				END { exit(filled ? 0 : 1) }
			' "$f" || printf 'no-scope      %s\n' "$b"
		fi
	done
	grep -o '^| [0-9][0-9]* |' "$INDEX" 2>/dev/null | tr -d '| ' | while IFS= read -r n; do
		[ -n "$n" ] || continue
		has=0
		for f in "$LOGS/$n"-*.md; do
			[ -e "$f" ] && has=1
		done
		[ "$has" -eq 1 ] || printf 'stale-row     %s (no file)\n' "$n"
	done
}

count_lines() {
	if [ -z "$1" ]; then
		printf '0'
	else
		printf '%s\n' "$1" | wc -l | tr -d ' '
	fi
}

report() {
	if [ "$3" -eq 0 ]; then
		printf '%s: none\n' "$1"
	else
		printf '%s: %s finding(s)\n' "$1" "$3"
		printf '%s\n' "$2" | sed 's/^/  /'
	fi
}

cmd_close() {
	local steps step out rc ok_n=0 fail_n=0 ref_n=0
	steps="$(pget close_steps)" || steps=""
	if [ -z "$steps" ]; then
		printf 'close: no close_steps in the profile\n'
		return 0
	fi
	printf 'close: %s step(s) from the profile\n' "$(printf '%s\n' "$steps" | wc -l | tr -d ' ')"
	while IFS= read -r step; do
		[ -n "$step" ] || continue
		if is_destructive "$step"; then
			ref_n=$((ref_n + 1))
			printf 'REFUSED   %s (delete or move; not run)\n' "$step"
			continue
		fi
		out="$(cd "$ROOT" && sh -c "$step" 2>&1)"
		rc=$?
		if [ "$rc" -eq 0 ]; then
			ok_n=$((ok_n + 1))
			printf 'OK        %s\n' "$step"
		else
			fail_n=$((fail_n + 1))
			printf 'FAIL(%s)  %s\n' "$rc" "$step"
		fi
		if [ -n "$out" ]; then
			printf '          %s\n' "$(printf '%s' "$out" | head -n 1 | cut -c1-160)"
		fi
	done <<EOF
$steps
EOF
	printf 'close: %s ok, %s failed, %s refused\n' "$ok_n" "$fail_n" "$ref_n"
	[ $((fail_n + ref_n)) -eq 0 ]
}

cmd_one() {
	local found count
	found="$($2)"
	count="$(count_lines "$found")"
	report "$1" "$found" "$count"
	return 0
}

cmd_all() {
	local o e i co ce ci total
	o="$(scan_orphans)"
	e="$(scan_empty)"
	i="$(scan_index)"
	co="$(count_lines "$o")"
	ce="$(count_lines "$e")"
	ci="$(count_lines "$i")"
	report orphans "$o" "$co"
	report empty "$e" "$ce"
	report index "$i" "$ci"
	total=$((co + ce + ci))
	if [ "$total" -eq 0 ]; then
		printf 'all: clean (no orphans, no empty files, no index gaps)\n'
	else
		printf 'all: %s finding(s) (orphans %s, empty %s, index %s)\n' "$total" "$co" "$ce" "$ci"
	fi
}

st_pass=0
st_fail=0
st_ok() { printf 'ok   %s\n' "$1"; st_pass=$((st_pass + 1)); }
st_bad() { printf 'FAIL %s\n' "$1"; st_fail=$((st_fail + 1)); }

self_test() {
	local proj out rc
	ST_TMP="$(mktemp -d)" || die "mktemp failed"
	trap 'rm -rf "$ST_TMP"' EXIT
	proj="$ST_TMP/proj"
	mkdir -p "$proj/.pi" "$proj/logs" "$proj/journal" "$proj/private" "$proj/sub" || die "cannot build the fixture"
	{
		printf '{\n'
		printf '  "name": "fixture",\n'
		printf '  "root": "%s",\n' "$proj"
		printf '  "logs": "logs",\n'
		printf '  "log_index": "logs/index.md",\n'
		printf '  "state": "STATE.md",\n'
		printf '  "progress": "progress.md",\n'
		printf '  "journal": "journal",\n'
		printf '  "scopes": ["product", "harness"],\n'
		printf '  "secret_dirs": ["private"],\n'
		printf '  "close_steps": ["test -f STATE.md", "exit 3", "rm -rf logs"]\n'
		printf '}\n'
	} > "$proj/.pi/beyin-project.json"
	printf '# state\n' > "$proj/STATE.md"
	printf '# progress\n- report: `reports/missing.md`\n- record: `logs/0001-a.md`\n' > "$proj/progress.md"
	printf '# 0001 a\n- **Date:** 2026-01-01\n- **Scope:** product\n' > "$proj/logs/0001-a.md"
	printf '# 0002 b\n- **Date:** 2026-01-02\n' > "$proj/logs/0002-b.md"
	{
		printf '# Experiment index\n\n'
		printf '| # | Title | Main result | Date |\n|---|---|---|---|\n'
		printf '| 0001 | a | 0.1 | 2026-01-01 |\n'
		printf '| 0009 | gone | - | 2026-01-02 |\n'
	} > "$proj/logs/index.md"
	: > "$proj/logs/.gitkeep"
	: > "$proj/private/empty.bin"
	printf 'today\n' > "$proj/journal/2026-01-01.md"

	out="$(cd "$proj" && "$SELF" close 2>&1)"
	rc=$?
	if [ "$rc" -eq 1 ] && printf '%s' "$out" | grep -q '^OK ' && printf '%s' "$out" | grep -q 'FAIL(3)' && printf '%s' "$out" | grep -q 'REFUSED'; then
		st_ok "close reports ok, failed and refused steps"
	else
		st_bad "close reports ok, failed and refused steps (exit $rc, out: $out)"
	fi
	if [ -f "$proj/logs/0001-a.md" ] && printf '%s' "$out" | grep -q '1 ok, 1 failed, 1 refused'; then
		st_ok "the refused step did not run and the summary counts it"
	else
		st_bad "the refused step did not run and the summary counts it (out: $out)"
	fi

	out="$(cd "$proj/sub" && "$SELF" orphans 2>&1)"
	if printf '%s' "$out" | grep -q 'reports/missing.md' && ! printf '%s' "$out" | grep -q 'logs/0001-a.md'; then
		st_ok "orphans finds the missing path only"
	else
		st_bad "orphans finds the missing path only (out: $out)"
	fi

	out="$(cd "$proj" && "$SELF" empty 2>&1)"
	if printf '%s' "$out" | grep -q 'logs/.gitkeep' && ! printf '%s' "$out" | grep -q 'private/empty.bin'; then
		st_ok "empty lists the empty file and skips secret dirs"
	else
		st_bad "empty lists the empty file and skips secret dirs (out: $out)"
	fi

	out="$(cd "$proj" && "$SELF" index 2>&1)"
	if printf '%s' "$out" | grep -q 'not-in-index.*0002-b.md' && printf '%s' "$out" | grep -q 'no-scope.*0002-b.md' && printf '%s' "$out" | grep -q 'stale-row.*0009'; then
		st_ok "index sees the missing row, the missing scope and the stale row"
	else
		st_bad "index sees the missing row, the missing scope and the stale row (out: $out)"
	fi

	out="$(cd "$proj" && "$SELF" all 2>&1)"
	if printf '%s' "$out" | grep -q '^all: 5 finding(s) (orphans 1, empty 1, index 3)'; then
		st_ok "all prints one verdict line"
	else
		st_bad "all prints one verdict line (out: $out)"
	fi

	mkdir -p "$ST_TMP/nowhere"
	out="$(cd "$ST_TMP/nowhere" && "$SELF" all 2>&1)"
	rc=$?
	if [ "$rc" -eq 1 ] && [ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" = "1" ] && printf '%s' "$out" | grep -q 'beyin-project.json'; then
		st_ok "a missing profile fails with one clear line"
	else
		st_bad "a missing profile fails with one clear line (exit $rc, out: $out)"
	fi

	(cd "$ST_TMP/nowhere" && "$SELF" --help >/dev/null 2>&1)
	rc=$?
	if [ "$rc" -eq 0 ]; then st_ok "--help works without a profile"; else st_bad "--help works without a profile (exit $rc)"; fi

	printf 'self-test: %s passed, %s failed\n' "$st_pass" "$st_fail"
	[ "$st_fail" -eq 0 ]
}

main() {
	local cmd=""
	[ "$#" -gt 0 ] && cmd="$1"
	case "$cmd" in
		"")
			usage >&2
			exit 2
			;;
		-h|--help|help)
			usage
			exit 0
			;;
		--self-test)
			self_test
			exit "$?"
			;;
	esac
	load_profile
	case "$cmd" in
		close)
			cmd_close
			exit "$?"
			;;
		orphans)
			cmd_one orphans scan_orphans
			;;
		empty)
			cmd_one empty scan_empty
			;;
		index)
			cmd_one index scan_index
			;;
		all)
			cmd_all
			;;
		*)
			die "unknown command: $cmd (see --help)"
			;;
	esac
}

main "$@"
