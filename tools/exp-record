#!/usr/bin/env bash
# exp-record: numbering, template, index and gap check for the experiment-record skill.
#
# The project profile is <project>/.pi/beyin-project.json, found by walking up from the current
# directory. Only the JSON read needs python3 (beyin.py already requires it); the rest is bash.
set -uo pipefail

PROG="exp-record"
SELF="$0"
case "$SELF" in
	/*) ;;
	*) SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")" ;;
esac

PROFILE=""
BASE=""
ROOT=""
LOGS=""
SCOPES=""
HARDWARE=""
ST_TMP=""

die() { printf '%s: %s\n' "$PROG" "$1" >&2; exit 1; }

usage() {
	cat <<'EOF'
exp-record - record numbering, template, index and gap check for the experiment-record skill.

Usage: exp-record <command> [options]

Commands
  next                          print the next free record number (4 digits) from the files on disk
  new --title T [--scope S] [--slug S]
                                create <logs>/NNNN-slug.md from the template, then rewrite the index
  index                         rewrite the index table from the records on disk (idempotent);
                                keeps the file's own H1, rebuilds the four standard columns
  check                         report records with an unfilled template field or missing heading;
                                exit 1 when at least one record has a gap
  --self-test                   run the built-in fixture test
  --help                        this text

Setup
  The profile is <project>/.pi/beyin-project.json, found by walking up from the current directory.
  Fields used: root, logs, log_index, scopes, hardware. Without the profile every command stops
  with one line.

Notes
  - The record number is the highest number in <logs>, plus one; files are the truth, not the index.
  - Scope is written only when the profile declares scopes; a value outside that list is refused.
  - The file name slug comes from --slug, else from --title with non-ascii characters dropped.
  - The template fields are Date, Goal / hypothesis, Dataset, Model / backbone, Settings, Seed,
    Hardware, Duration and the headings Results, Observation, Decision, Next step.
  - Existing records keep their own headings; only new files get the template.
EOF
}

profile_path() {
	local d
	d="$(pwd -P)" || return 1
	while :; do
		if [ -f "$d/.pi/beyin-project.json" ]; then
			printf '%s' "$d/.pi/beyin-project.json"
			return 0
		fi
		[ "$d" = "/" ] && break
		d="$(dirname "$d")"
	done
	return 1
}

pget() {
	python3 - "$PROFILE" "$1" <<'PY'
import json, sys

try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    sys.exit(3)
if not isinstance(data, dict):
    sys.exit(3)
value = data.get(sys.argv[2])
if value is None:
    sys.exit(4)
if isinstance(value, list):
    for item in value:
        print(item)
elif isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
PY
}

abs() {
	case "$1" in
		/*) printf '%s' "$1" ;;
		*) printf '%s/%s' "$ROOT" "$1" ;;
	esac
}

rel() {
	case "$1" in
		"$ROOT"/*) printf '%s' "$1" | sed "s|^$ROOT/||" ;;
		*) printf '%s' "$1" ;;
	esac
}

load_profile() {
	local r
	command -v python3 >/dev/null 2>&1 || die "python3 is required to read the profile"
	PROFILE="$(profile_path)" || die "no .pi/beyin-project.json found from $(pwd -P) upward"
	python3 -c 'import json,sys; json.load(open(sys.argv[1], encoding="utf-8"))' "$PROFILE" 2>/dev/null \
		|| die "cannot read $PROFILE as JSON"
	BASE="$(dirname "$(dirname "$PROFILE")")"
	r="$(pget root)" || r=""
	if [ -n "$r" ] && [ -d "$r" ]; then
		ROOT="$(cd "$r" && pwd)"
	elif [ -n "$r" ] && [ -d "$BASE/$r" ]; then
		ROOT="$(cd "$BASE/$r" && pwd)"
	else
		ROOT="$(cd "$BASE" && pwd)"
	fi
	LOGS="$(abs "$(pget logs || printf 'logs')")"
	SCOPES="$(pget scopes)" || SCOPES=""
	HARDWARE="$(pget hardware)" || HARDWARE=""
}

is_record_name() {
	case "$1" in
		[0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]) return 0 ;;
	esac
	return 1
}

number_of() {
	local n
	n="$(printf '%s' "$1" | cut -d- -f1)"
	is_record_name "$n" || return 1
	printf '%s' "$n"
}

max_number() {
	local f b n max=0
	for f in "$LOGS"/*.md; do
		[ -e "$f" ] || continue
		b="$(basename "$f")"
		n="$(number_of "$b")" || continue
		if [ "$((10#$n))" -gt "$max" ]; then
			max="$((10#$n))"
		fi
	done
	printf '%s' "$max"
}

cmd_next() {
	printf '%04d' "$(( $(max_number) + 1 ))"
}

slugify() {
	local s
	s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-*//; s/-*$//')"
	[ -n "$s" ] || s="record"
	printf '%s' "$s"
}

index_path() {
	local i
	i="$(pget log_index)" || i=""
	if [ -z "$i" ]; then
		printf '%s/index.md' "$LOGS"
		return 0
	fi
	abs "$i"
}

list_records() {
	local f b n
	for f in "$LOGS"/*.md; do
		[ -e "$f" ] || continue
		b="$(basename "$f")"
		n="$(number_of "$b")" || continue
		printf '%s %s\n' "$n" "$b"
	done | sort -n -k1,1
}

result_of() {
	awk '
		/^## Results/ { inres = 1; next }
		inres && /^## / { exit }
		inres && /^[|]/ {
			rows++
			if (rows <= 2) next
			line = $0
			sub(/^[|]/, "", line)
			sub(/[|][[:space:]]*$/, "", line)
			split(line, cell, "|")
			v = ""
			if (length(cell) >= 2) {
				v = cell[2]
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
			}
			if (v == "") {
				v = cell[1]
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
			}
			if (v != "" && v != "...") { print v; exit }
		}
	' "$1"
}

write_index() {
	local idx tmp header dir num name file t d r
	idx="$(index_path)"
	dir="$(dirname "$idx")"
	mkdir -p "$dir" || die "cannot create $dir"
	tmp="$idx.tmp.$$"
	header=""
	if [ -f "$idx" ]; then
		header="$(awk '/^# /{print; exit}' "$idx")"
	fi
	[ -n "$header" ] || header="# Experiment/Decision Index"
	{
		printf '%s\n\n' "$header"
		printf '| # | Title | Main result | Date |\n|---|---|---|---|\n'
		list_records | while read -r num name; do
			[ -n "$num" ] || continue
			file="$LOGS/$name"
			t="$(awk '/^# /{sub(/^#[[:space:]]*/,""); print; exit}' "$file" | sed 's/^[0-9][0-9]*-*[[:space:]]*//' | tr '|' '/')"
			d="$(awk '/^- [*][*]Date:/{sub(/^- [*][*]Date:[*][*][[:space:]]*/,""); print; exit}' "$file" | tr '|' '/')"
			r="$(result_of "$file" | tr '|' '/' | cut -c1-100)"
			[ -n "$t" ] || t="$name"
			[ -n "$d" ] || d="-"
			[ -n "$r" ] || r="-"
			printf '| %s | %s | %s | %s |\n' "$num" "$t" "$r" "$d"
		done
	} > "$tmp" || { rm -f "$tmp"; die "cannot write $tmp"; }
	mv "$tmp" "$idx" || { rm -f "$tmp"; die "cannot replace $idx"; }
	printf 'indexed %s\n' "$(rel "$idx")"
}

cmd_new() {
	local title="" scope="" slug="" n file today
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--title)
				[ "$#" -ge 2 ] || die "--title needs a value"
				title="$2"
				shift 2
				;;
			--scope)
				[ "$#" -ge 2 ] || die "--scope needs a value"
				scope="$2"
				shift 2
				;;
			--slug)
				[ "$#" -ge 2 ] || die "--slug needs a value"
				slug="$2"
				shift 2
				;;
			-h|--help)
				usage
				exit 0
				;;
			*)
				die "unknown argument: $1 (see --help)"
				;;
		esac
	done
	[ -n "$title" ] || die "new needs --title T"
	if [ -n "$scope" ] && [ -n "$SCOPES" ]; then
		printf '%s\n' "$SCOPES" | grep -qx -- "$scope" ||
			die "unknown scope: $scope (profile scopes: $(printf '%s' "$SCOPES" | tr '\n' ' '))"
	fi
	[ -n "$slug" ] || slug="$(slugify "$title")"
	mkdir -p "$LOGS" || die "cannot create $LOGS"
	n="$(cmd_next)"
	file="$LOGS/$n-$slug.md"
	[ -e "$file" ] && die "$file already exists"
	today="$(date +%Y-%m-%d)"
	{
		printf '# %s %s\n\n' "$n" "$title"
		printf -- '- **Date:** %s\n' "$today"
		if [ -n "$scope" ]; then
			printf -- '- **Scope:** %s\n' "$scope"
		elif [ -n "$SCOPES" ]; then
			printf -- '- **Scope:**\n'
		fi
		printf -- '- **Goal / hypothesis:**\n'
		printf -- '- **Dataset:**\n'
		printf -- '- **Model / backbone:**\n'
		printf -- '- **Settings:** batch= lr= epochs= img_size= optimizer= AMP= freeze=\n'
		printf -- '- **Seed:**\n'
		if [ -n "$HARDWARE" ]; then
			printf -- '- **Hardware:** %s\n' "$HARDWARE"
		else
			printf -- '- **Hardware:**\n'
		fi
		printf -- '- **Duration:**\n\n'
		printf '## Results\n\n| Metric | Value |\n|---|---|\n| | |\n\n'
		printf '## Observation\n\n## Decision\n\n## Next step\n'
	} > "$file" || die "cannot write $file"
	printf 'created %s\n' "$(rel "$file")"
	write_index
}

FIELDS="Date
Goal / hypothesis
Dataset
Model / backbone
Settings
Seed
Hardware
Duration"

HEADINGS="Results
Observation
Decision
Next step"

has_field() {
	awk -v label="$2" '
		BEGIN { prefix = "- **" label ":**"; seen = 0; filled = 0 }
		{
			if (index($0, prefix) == 1) {
				seen = 1
				v = substr($0, length(prefix) + 1)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
				if (v != "") filled = 1
			}
		}
		END { if (filled) exit 0; if (seen) exit 2; exit 1 }
	' "$1"
}

has_heading() {
	awk -v h="$2" '
		BEGIN { target = "## " h; found = 0 }
		{ line = $0; sub(/[[:space:]]+$/, "", line); if (line == target) found = 1 }
		END { exit(found ? 0 : 1) }
	' "$1"
}

cmd_check() {
	local f b label rc gaps total=0 gaps_files=0
	for f in "$LOGS"/*.md; do
		[ -e "$f" ] || continue
		b="$(basename "$f")"
		number_of "$b" >/dev/null || continue
		total=$((total + 1))
		gaps=""
		while IFS= read -r label; do
			[ -n "$label" ] || continue
			has_field "$f" "$label"
			rc=$?
			case "$rc" in
				0) ;;
				2) gaps="$gaps, $label(empty)" ;;
				*) gaps="$gaps, $label(missing)" ;;
			esac
			if [ "$label" = "Date" ] && [ -n "$SCOPES" ]; then
				has_field "$f" "Scope"
				rc=$?
				case "$rc" in
					0) ;;
					2) gaps="$gaps, Scope(empty)" ;;
					*) gaps="$gaps, Scope(missing)" ;;
				esac
			fi
		done <<EOF
$FIELDS
EOF
		while IFS= read -r label; do
			[ -n "$label" ] || continue
			has_heading "$f" "$label" || gaps="$gaps, heading $label(missing)"
		done <<EOF
$HEADINGS
EOF
		if [ -n "$gaps" ]; then
			gaps_files=$((gaps_files + 1))
			printf '%s: %s\n' "$(rel "$f")" "$(printf '%s' "$gaps" | sed 's/^, //')"
		fi
	done
	if [ "$total" -eq 0 ]; then
		printf 'check: no records in %s\n' "$(rel "$LOGS")"
		return 0
	fi
	printf 'check: %s of %s record(s) have gaps\n' "$gaps_files" "$total"
	[ "$gaps_files" -eq 0 ]
}

st_pass=0
st_fail=0
st_ok() { printf 'ok   %s\n' "$1"; st_pass=$((st_pass + 1)); }
st_bad() { printf 'FAIL %s\n' "$1"; st_fail=$((st_fail + 1)); }

self_test() {
	local proj out rc n rec pair label value
	ST_TMP="$(mktemp -d)" || die "mktemp failed"
	trap 'rm -rf "$ST_TMP"' EXIT
	proj="$ST_TMP/proj"
	mkdir -p "$proj/.pi" "$proj/logs" "$proj/sub/deep" || die "cannot build the fixture"
	{
		printf '{\n'
		printf '  "name": "fixture",\n'
		printf '  "root": "%s",\n' "$proj"
		printf '  "logs": "logs",\n'
		printf '  "log_index": "logs/index.md",\n'
		printf '  "scopes": ["product", "harness"],\n'
		printf '  "hardware": "fixture box"\n'
		printf '}\n'
	} > "$proj/.pi/beyin-project.json"

	out="$(cd "$proj/sub/deep" && "$SELF" next 2>&1)"
	if [ "$out" = "0001" ]; then st_ok "next is 0001 from a subdirectory"; else st_bad "next is 0001 (got: $out)"; fi

	out="$(cd "$proj" && "$SELF" new --title "Batch 8 OOM" --scope product 2>&1)"
	if [ -f "$proj/logs/0001-batch-8-oom.md" ] && [ "$(grep -c '^- [*][*]Scope:[*][*] product$' "$proj/logs/0001-batch-8-oom.md")" = "1" ]; then
		st_ok "new writes the record with its scope"
	else
		st_bad "new writes the record with its scope (out: $out)"
	fi
	if grep -q '^- [*][*]Hardware:[*][*] fixture box$' "$proj/logs/0001-batch-8-oom.md"; then
		st_ok "new prefills the profile hardware"
	else
		st_bad "new prefills the profile hardware"
	fi
	if grep -q '| 0001 | Batch 8 OOM |' "$proj/logs/index.md"; then
		st_ok "the index carries the new row"
	else
		st_bad "the index carries the new row"
	fi

	out="$(cd "$proj" && "$SELF" next 2>&1)"
	if [ "$out" = "0002" ]; then st_ok "next moves to 0002"; else st_bad "next moves to 0002 (got: $out)"; fi

	cp "$proj/logs/index.md" "$ST_TMP/index.before"
	(cd "$proj" && "$SELF" index >/dev/null 2>&1)
	if cmp -s "$ST_TMP/index.before" "$proj/logs/index.md"; then st_ok "index is idempotent"; else st_bad "index is idempotent"; fi

	(cd "$proj" && "$SELF" check >/dev/null 2>&1)
	rc=$?
	if [ "$rc" -eq 1 ]; then st_ok "check exits 1 on a fresh record"; else st_bad "check exits 1 on a fresh record (exit $rc)"; fi
	out="$(cd "$proj" && "$SELF" check 2>&1)"
	if printf '%s' "$out" | grep -q 'Seed(empty)'; then st_ok "check names the empty field"; else st_bad "check names the empty field (out: $out)"; fi

	rec="$proj/logs/0001-batch-8-oom.md"
	for pair in "Goal / hypothesis|first run" "Dataset|toy 120 images" "Model / backbone|yolo-n" "Seed|42" "Duration|3m"; do
		label="$(printf '%s' "$pair" | cut -d'|' -f1)"
		value="$(printf '%s' "$pair" | cut -d'|' -f2-)"
		awk -v label="$label" -v value="$value" '
			{ if ($0 == "- **" label ":**") print "- **" label ":** " value; else print }
		' "$rec" > "$rec.new" && mv "$rec.new" "$rec"
	done
	(cd "$proj" && "$SELF" check >/dev/null 2>&1)
	rc=$?
	if [ "$rc" -eq 0 ]; then st_ok "check exits 0 when the fields are filled"; else st_bad "check exits 0 when the fields are filled (exit $rc)"; fi

	out="$(cd "$proj" && "$SELF" new --title "Ikinci deneme" --slug deneme-2 2>&1)"
	if [ -f "$proj/logs/0002-deneme-2.md" ] && [ "$(grep -c '^| 0002 | Ikinci deneme |' "$proj/logs/index.md")" = "1" ]; then
		st_ok "--slug names the file"
	else
		st_bad "--slug names the file (out: $out)"
	fi

	out="$(cd "$proj" && "$SELF" new --title "bad scope" --scope nowhere 2>&1)"
	rc=$?
	if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -q 'unknown scope'; then
		st_ok "an unknown scope is refused"
	else
		st_bad "an unknown scope is refused (exit $rc, out: $out)"
	fi

	mkdir -p "$ST_TMP/nowhere"
	out="$(cd "$ST_TMP/nowhere" && "$SELF" next 2>&1)"
	rc=$?
	n="$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
	if [ "$rc" -eq 1 ] && [ "$n" = "1" ] && printf '%s' "$out" | grep -q 'beyin-project.json'; then
		st_ok "a missing profile fails with one clear line"
	else
		st_bad "a missing profile fails with one clear line (exit $rc, out: $out)"
	fi

	(cd "$ST_TMP/nowhere" && "$SELF" --help >/dev/null 2>&1)
	rc=$?
	if [ "$rc" -eq 0 ]; then st_ok "--help works without a profile"; else st_bad "--help works without a profile (exit $rc)"; fi

	printf 'self-test: %s passed, %s failed\n' "$st_pass" "$st_fail"
	[ "$st_fail" -eq 0 ]
}

main() {
	local cmd=""
	[ "$#" -gt 0 ] && cmd="$1"
	case "$cmd" in
		"")
			usage >&2
			exit 2
			;;
		-h|--help|help)
			usage
			exit 0
			;;
		--self-test)
			self_test
			exit "$?"
			;;
	esac
	load_profile
	case "$cmd" in
		next)
			cmd_next
			printf '\n'
			;;
		new)
			shift
			cmd_new "$@"
			;;
		index)
			write_index
			;;
		check)
			cmd_check
			exit "$?"
			;;
		*)
			die "unknown command: $cmd (see --help)"
			;;
	esac
}

main "$@"
